{
	"name": "schedx",
	"version": "2.0.0",
	"description": "Self-hosted X (Twitter) post scheduler",
	"private": true,
	"type": "module",
	"license": "Elastic-2.0",
	"author": "wyatts97",
	"repository": {
		"type": "git",
		"url": "https://github.com/wyatts97/SchedX"
	},
	"engines": {
		"node": ">=22.17.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"gen:secrets": "node scripts/gen-secrets.js"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"better-sqlite3": "^13.0.3",
		"croner": "^10.0.1",
		"drizzle-orm": "^0.45.4",
		"pino": "^10.4.0",
		"sharp": "^0.35.5",
		"temporal-polyfill": "0.3.0",
		"twitter-api-v2": "^1.29.1",
		"twitter-text": "^3.1.0",
		"web-push": "^3.6.7",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.60.0",
		"@schedule-x/calendar": "^3.7.3",
		"@schedule-x/drag-and-drop": "^3.7.3",
		"@schedule-x/svelte": "^3.0.0",
		"@schedule-x/theme-default": "^3.7.3",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"@types/twitter-text": "^3.1.10",
		"@types/web-push": "^3.6.4",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"emoji-picker-element": "^1.29.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	}
}
