# SchedX configuration. Copy to .env and fill in. Generate secrets with: npm run gen:secrets

# Where the SQLite database, uploads and backups live
DATA_DIR=./data

# Required: encrypts X tokens at rest (32+ random characters). Changing it disconnects accounts.
ENCRYPTION_KEY=

# Public URL of the app. Used to build the X OAuth callback: <APP_URL>/auth/x/callback
# Local dev: http://127.0.0.1:5173   Behind Cloudflare Tunnel: https://schedx.example.com
APP_URL=http://127.0.0.1:5173

# X API — "live" (default) or "mock" (fake client: nothing is posted, nothing is billed)
X_API_MODE=mock
# From developer.x.com → your app → Keys and tokens → OAuth 2.0 Client ID and Client Secret
X_CLIENT_ID=
X_CLIENT_SECRET=

# Web push notifications (optional). Leave empty to disable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Max upload size in MB (Cloudflare's free plan caps request bodies at 100 MB)
MAX_UPLOAD_MB=100

# Logging: fatal | error | warn | info | debug
LOG_LEVEL=info

# Set to "off" to run the web UI without publishing anything
SCHEDULER=on
